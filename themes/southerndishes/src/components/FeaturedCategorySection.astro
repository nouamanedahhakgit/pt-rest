---
import type { Recipe } from '../types/recipe';

interface Props {
  badge?: string;
  title: string;
  description: string;
  featuredImage: string;
  buttonText?: string;
  buttonLink: string;
  recipes: Recipe[];
}

const {
  badge = "YUMMY!",
  title,
  description,
  featuredImage,
  buttonText = "More Recipes",
  buttonLink,
  recipes
} = Astro.props;

// Take first 6 recipes for 3x2 grid
const displayRecipes = recipes.slice(0, 6);
---

<section class="w-full bg-cream-50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left: Featured Card -->
      <div class="lg:col-span-4">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg border-2 border-coral-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
          <!-- Featured Image with Badge -->
          <div class="relative">
            <img
              src={featuredImage}
              alt={title}
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
            />
            <!-- Badge -->
            <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-gradient-to-r from-coral-500 to-coral-600 text-white text-sm font-bold uppercase tracking-wider px-6 py-2.5 rounded-full shadow-xl">
              {badge}
            </div>
          </div>

          <!-- Content Below Image -->
          <div class="p-6 text-center">
            <!-- Title -->
            <h2 class="font-heading text-3xl text-gray-900 mb-3">
              {title}
            </h2>

            <!-- Description -->
            <p class="text-gray-600 text-sm mb-6 leading-relaxed">
              {description}
            </p>

            <!-- Button -->
            <a
              href={buttonLink}
              class="inline-flex items-center justify-center gap-2 bg-coral-500 hover:bg-coral-600 text-white font-bold px-8 py-3.5 rounded-full transition-all duration-300 group shadow-lg hover:shadow-xl hover:scale-105"
            >
              {buttonText}
              <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Recipe Grid (3x2) -->
      <div class="lg:col-span-8">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {displayRecipes.map((recipe) => (
            <a
              href={`/${recipe.slug}/`}
              class="group block bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 border border-coral-100 hover:border-coral-300 hover:-translate-y-1"
            >
              <!-- Recipe Image -->
              <div class="aspect-square overflow-hidden">
                <img
                  src={recipe.featured_image}
                  alt={recipe.title}
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                />
              </div>

              <!-- Recipe Title -->
              <div class="p-3">
                <h3 class="font-semibold text-sm text-gray-900 group-hover:text-coral-600 transition-colors line-clamp-2 leading-tight">
                  {recipe.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
