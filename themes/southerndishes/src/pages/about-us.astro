@media (max-width: 480px) {
  .about-hero {
    padding: 3rem 1rem 2rem;
  }

  .about-greeting {
    font-size: 1.875rem;
  }

  .about-hero-title {
    font-size: 2rem;
  }

  .about-hero-text {
    font-size: 1rem;
  }

  .author-feature {
    padding: 3rem 1rem;
  }

  .author-main-photo {
    height: 300px;
  }

  .image-decoration {
    top: -10px;
    left: -10px;
    right: 10px;
    bottom: 10px;
  }

  .author-feature-name {
    font-size: 1.75rem;
  }

  .author-feature-title {
    font-size: 1rem;
  }

  .author-feature-bio {
    font-size: 0.9375rem;
  }



  .stat-number {
    font-size: 1.75rem;
  }

  .stat-label {
    font-size: 0.8125rem;
  }

  .story-section {
    padding: 3rem 1rem;
  }

  .story-content {
    font-size: 0.9375rem;
  }

  .story-content h2 {
    font-size: 1.75rem;
    margin-top: 1.75rem;
  }

  .story-content h3 {
    font-size: 1.375rem;
    margin-top: 1.5rem;
  }

  .team-showcase {
    padding: 3rem 1rem;
  }

  .team-handwriting {
    font-size: 1.75rem;
  }

  .team-showcase-title {
    font-size: 1.75rem;
    margin-bottom: 2rem;
  }

  .team-card {
    padding: 2rem 1.5rem 1.5rem;
  }

  .team-card-photo {
    width: 140px;
    height: 140px;
  }

  .team-card-name {
    font-size: 1.375rem;
  }

  .about-cta {
    padding: 3rem 1rem;
  }

  .about-cta-handwriting {
    font-size: 1.75rem;
  }

  .about-cta-title {
    font-size: 1.875rem;
  }

  .about-cta-description {
    font-size: 1rem;
  }

  .about-cta-btn {
    padding: 1rem 2rem;
    font-size: 0.9375rem;
  }
}
</style>
