---
import Layout from '../../layouts/Layout.astro';
import { DatabaseService } from '../../lib/database';

export const prerender = false;

export async function getStaticPaths() {
  return [];
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const db = new DatabaseService(Astro.locals.runtime?.env?.DB || {} as any);

let page;
let settings: Record<string, string> = {};

try {
  if (Astro.locals.runtime?.env?.DB) {
    [page, settings] = await Promise.all([
      db.getPageBySlug(slug),
      db.getAllSettings()
    ]);

    if (!page) {
      return Astro.redirect('/404');
    }
  }
} catch (error) {
  console.error('Error fetching page:', error);
  return Astro.redirect('/404');
}

if (!page) {
  return Astro.redirect('/404');
}

const siteName = settings.site_name || 'ChefTaling';
const siteDomain = settings.site_domain || 'cheftaling.com';
const contactEmail = settings.contact_email || 'contact@cheftaling.com';

// Replace template variables in page content
if (page && page.content) {
  page.content = page.content
    .replace(/\{\{site_name\}\}/g, siteName)
    .replace(/\{\{site_domain\}\}/g, siteDomain)
    .replace(/\{\{contact_email\}\}/g, contactEmail);
}
---

<Layout
  title={`${page.title} - ${siteName}`}
  description={page.meta_description || page.title}
  canonical={Astro.url.toString()}
>
  <!-- Page Header -->
  <div class="page-header">
    <div class="wrap">
      <!-- Breadcrumb -->
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-3 text-sm">
          <li>
            <a href="/" class="breadcrumb-link">
              <svg class="w-4 h-4 mr-1 inline" fill="currentColor" viewBox="0 0 24 24">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              Home
            </a>
          </li>
          <li class="breadcrumb-separator">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9.29 15.88L13.17 12 9.29 8.12a.996.996 0 1 1 1.41-1.41l4.59 4.59c.39.39.39 1.02 0 1.41L10.7 17.3a.996.996 0 0 1-1.41-1.42z"/>
            </svg>
          </li>
          <li class="breadcrumb-current">
            {page.title}
          </li>
        </ol>
      </nav>

      <h1 class="page-title">{page.title}</h1>
    </div>
  </div>

  <!-- Page Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="page-content">
      <Fragment set:html={page.content} />
    </div>
  </div>

</Layout>

<style is:global>
/* ================================
   PAGE HEADER
   ================================ */

.page-header {
  background: #f8fafc;
  color: #1f2937;
  padding: 2rem 0;
  border-bottom: 1px solid #e5e7eb;
}

.page-header .wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.page-title {
  font-size: 2.5rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
  color: #111827;
  font-family: 'Frank Ruhl Libre', georgia, serif;
}

/* Breadcrumb styles */
.breadcrumb-link {
  display: inline-flex;
  align-items: center;
  color: #6b7280;
  text-decoration: none;
  transition: color 0.2s ease;
}

.breadcrumb-link:hover {
  color: #2ec9ad;
}

.breadcrumb-separator {
  color: #d1d5db;
}

.breadcrumb-current {
  color: #111827;
  font-weight: 600;
}

/* ================================
   PAGE CONTENT STYLING
   ================================ */

.page-content {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  color: #1f2937;
  line-height: 1.7;
  font-size: 1rem;
}

.page-content h2 {
  font-family: 'Frank Ruhl Libre', georgia, serif;
  font-size: 2rem;
  font-weight: 700;
  color: #111827;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

.page-content h2:first-child {
  margin-top: 0;
}

.page-content h3 {
  font-family: 'Frank Ruhl Libre', georgia, serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: #111827;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.page-content h4 {
  font-family: 'Frank Ruhl Libre', georgia, serif;
  font-size: 1.25rem;
  font-weight: 600;
  color: #374151;
  margin-top: 2rem;
  margin-bottom: 0.75rem;
  line-height: 1.4;
}

.page-content p {
  margin-bottom: 1.25rem;
  color: #374151;
  line-height: 1.7;
  font-size: 1rem;
}

.page-content strong {
  font-weight: 600;
  color: #111827;
}

.page-content ul,
.page-content ol {
  margin-bottom: 1.5rem;
  padding-left: 2rem;
  color: #374151;
}

.page-content ul {
  list-style-type: disc;
}

.page-content ol {
  list-style-type: decimal;
}

.page-content li {
  margin-bottom: 0.5rem;
  line-height: 1.7;
}

.page-content a {
  color: #2ec9ad;
  text-decoration: underline;
  transition: color 0.2s ease;
}

.page-content a:hover {
  color: #24a38a;
}

/* Responsive Design */
@media (max-width: 768px) {
  .page-header {
    padding: 1.5rem 0;
  }

  .page-title {
    font-size: 2rem;
  }

  .page-content h2 {
    font-size: 1.75rem;
    margin-top: 2rem;
  }

  .page-content h3 {
    font-size: 1.375rem;
    margin-top: 1.75rem;
  }

  .page-content h4 {
    font-size: 1.125rem;
    margin-top: 1.5rem;
  }

  .page-content {
    font-size: 0.9375rem;
  }
}

@media (max-width: 480px) {
  .page-title {
    font-size: 1.75rem;
  }

  .page-content h2 {
    font-size: 1.5rem;
  }

  .page-content h3 {
    font-size: 1.25rem;
  }

  .page-content h4 {
    font-size: 1rem;
  }
}
</style>
