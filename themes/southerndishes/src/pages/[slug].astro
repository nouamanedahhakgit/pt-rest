/* ================================
   PRINT STYLES
   ================================ */

@media print {
  /* Hide everything except the main recipe content */
  .post-header,
  .breadcrumb,
  .author-box,
  .more-recipes-box,
  nav,
  header,
  footer,
  .pinterest-share-button,
  .jump-to-recipe-button,
  button,
  .article-content,
  .lg\:col-span-1 {
    display: none !important;
  }

  /* Show only the recipe card area */
  body {
    margin: 0;
    padding: 0;
    background: white;
  }

  /* Make the main content full width */
  .max-w-7xl,
  .grid,
  .lg\:col-span-2 {
    max-width: 100% !important;
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block !important;
  }

  /* Print Recipe Title */
  #recipe-card::before {
    content: attr(data-recipe-title);
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 1rem;
    page-break-after: avoid;
  }

  /* Ensure recipe card is visible and formatted for print */
  #recipe-card {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 20px !important;
    box-shadow: none !important;
    border: none !important;
    page-break-inside: avoid;
  }

  /* Recipe card typography for print */
  #recipe-card h2,
  #recipe-card h3 {
    page-break-after: avoid;
    color: #111827 !important;
  }

  #recipe-card ul,
  #recipe-card ol {
    page-break-inside: avoid;
  }

  #recipe-card li {
    page-break-inside: avoid;
  }

  /* Remove background colors and borders for print */
  #recipe-card * {
    background: white !important;
    box-shadow: none !important;
  }

  /* Ensure text is black for printing */
  #recipe-card,
  #recipe-card * {
    color: #000 !important;
  }

  /* Optimize spacing for print */
  #recipe-card h2 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  #recipe-card ul,
  #recipe-card ol {
    margin: 0.5rem 0;
  }

  #recipe-card li {
    margin: 0.25rem 0;
  }

  /* Hide print button when printing */
  button[onclick*="print"] {
    display: none !important;
  }
}
