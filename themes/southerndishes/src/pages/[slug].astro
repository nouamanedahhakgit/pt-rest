---
import Layout from '../layouts/Layout.astro';
import RecipeDetails from '../components/RecipeDetails.astro';
import RecipeGrid from '../components/RecipeGrid.astro';
import AmazonProductGrid from '../components/AmazonProductGrid.astro';
import { DatabaseService } from '../lib/database';
import { generateRecipeJsonLd, calculateReadTime, stripHtml, getResponsiveSrcSet, getImageSizes, getPinterestImageUrl, decodeHtmlEntities } from '../lib/utils';
import {
  type AdProvider,
  type AdSettings,
  injectContentAds,
  getAdPlaceholder
} from '../lib/ads';

export const prerender = false;

export async function getStaticPaths() {
  return [];
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const db = new DatabaseService(Astro.locals.runtime?.env?.DB || {} as any);

let recipe;
let relatedRecipes = [];
let sidebarProducts = [];
let settings: Record<string, string> = {};

try {
  if (Astro.locals.runtime?.env?.DB) {
    [recipe, settings] = await Promise.all([
      db.getRecipeBySlug(slug),
      db.getAllSettings()
    ]);

    if (!recipe) {
      // Check if there's a redirect for this slug
      const redirectUrl = await db.getRedirect(slug);
      if (redirectUrl) {
        return Astro.redirect(redirectUrl, 301);
      }
      return Astro.redirect('/404');
    }

    if (recipe.category_id) {
      relatedRecipes = await db.getRelatedRecipes(recipe.category_id, recipe.id, 3);
    }

    // Fetch global Amazon products (products marked to show on all recipes)
    const globalProducts = await db.getGlobalAmazonProducts();

    // Display products in sidebar
    sidebarProducts = globalProducts as any[];
  }
} catch (error) {
  console.error('Error fetching recipe:', error);
  return Astro.redirect('/404');
}

if (!recipe) {
  return Astro.redirect('/404');
}

console.log('Article Content:', recipe.article_content);

// Ad provider settings
const adProvider = (settings.ad_provider || 'ezoic') as AdProvider;
const adSettings = settings as AdSettings;

// Inject ads into article content using the multi-provider system
let articleContentWithAds = injectContentAds(recipe.article_content, adProvider, adSettings);

// Get ad placeholders for this page
const underTitleAd = getAdPlaceholder('under_page_title', adProvider, false, adSettings);
const sidebarAd = getAdPlaceholder('sidebar', adProvider, true, adSettings);
const sidebarMiddleAd = getAdPlaceholder('sidebar_middle', adProvider, true, adSettings);
const recipeCardAd = getAdPlaceholder('recipe_card', adProvider, true, adSettings);

// Inject Amazon products before FAQs H2 heading
if (sidebarProducts.length > 0) {
  const faqsRegex = /<h2[^>]*>.*?FAQs.*?<\/h2>/i;
  if (faqsRegex.test(articleContentWithAds)) {
    const productsToShow = sidebarProducts.slice(0, 3);
    const productsHtml = `
<div class="amazon-products-inline">
  <div class="afxshop-products-grid" data-col="3">
      ${productsToShow.map(product => `
        <div class="afxshop-product-item">
          <div class="afxshop-product-header">
            <a href="${product.amazon_url}" target="_blank" rel="nofollow noopener">
              <div class="afxshop-product-image">
                <img src="${product.image_url}" alt="${product.title}" aria-hidden="true" loading="lazy" />
              </div>
              <div class="afxshop-product-content">
                <div class="afxshop-product-title">${product.title}</div>
              </div>
            </a>
          </div>
          <div class="afxshop-product-footer">
            <div class="afxshop-product-offer">
              <a href="${product.amazon_url}" target="_blank" rel="nofollow noopener">
                <div class="afxshop-product-wrap">
                  <div class="afxshop-product-left">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/d/de/Amazon_icon.png" alt="Amazon" class="afxshop-product-amazon-icon" />
                    ${product.price ? `<span class="afxshop-product-price">${product.price}</span>` : ''}
                  </div>
                  <div class="afxshop-product-btn">
                    <div class="afxshop-product-button">
                      Shop Now
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      `).join('')}
  </div>
</div>`;

    articleContentWithAds = articleContentWithAds.replace(faqsRegex, (match) => productsHtml + '\n' + match);
  }
}


const readTime = calculateReadTime(recipe.article_content);
const description = recipe.pin_description || recipe.recipe_data.summary || stripHtml(recipe.article_content);
const jsonLd = generateRecipeJsonLd(recipe.recipe_data, Astro.url.toString(), recipe.featured_image);

// Get social media URLs from settings
const facebookUrl = settings.facebook_url || 'https://facebook.com';
const pinterestUrl = settings.pinterest_url || 'https://pinterest.com';

// Responsive images for featured image (larger sizes for detail page)
const featuredImageSrcset = getResponsiveSrcSet(recipe.featured_image, [640, 960, 1280, 1920]);
const featuredImageSizes = getImageSizes([
  { maxWidth: '640px', size: '100vw' },
  { maxWidth: '1024px', size: '66vw' },
  { maxWidth: '9999px', size: '800px' }
]);

// Clean Pinterest image URL (remove query parameters that cause Pinterest issues)
const cleanPinterestImage = getPinterestImageUrl(recipe.pin_image || recipe.featured_image);
console.log('Original image URL:', recipe.pin_image || recipe.featured_image);
console.log('Clean Pinterest URL:', cleanPinterestImage);
---

<Layout
  title={`${decodeHtmlEntities(recipe.title)} - Recipe Website`}
  description={description}
  image={recipe.featured_image}
  canonical={Astro.url.toString()}
  jsonLd={jsonLd}
>
  <!-- Recipe Header -->
    <div class="post-header">
      <div class="wrap">
        <!-- Modern Breadcrumb -->
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-3 text-sm">
            <li>
              <a href="/" class="breadcrumb-link">
                <svg class="w-4 h-4 mr-1 inline" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                Home
              </a>
            </li>
            <li class="breadcrumb-separator">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9.29 15.88L13.17 12 9.29 8.12a.996.996 0 1 1 1.41-1.41l4.59 4.59c.39.39.39 1.02 0 1.41L10.7 17.3a.996.996 0 0 1-1.41-1.42z"/>
              </svg>
            </li>
            {recipe.category && (
              <>
                <li>
                  <a href={`/category/${recipe.category.slug}/`} class="breadcrumb-link">
                    {decodeHtmlEntities(recipe.category.name)}
                  </a>
                </li>
                <li class="breadcrumb-separator">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9.29 15.88L13.17 12 9.29 8.12a.996.996 0 1 1 1.41-1.41l4.59 4.59c.39.39.39 1.02 0 1.41L10.7 17.3a.996.996 0 0 1-1.41-1.42z"/>
                  </svg>
                </li>
              </>
            )}
            <li class="breadcrumb-current">
              {decodeHtmlEntities(recipe.title)}
            </li>
          </ol>
        </nav>
        <h1 class="entry-title">{decodeHtmlEntities(recipe.title)}</h1>

        <!-- Under Title Ad -->
        {underTitleAd && <Fragment set:html={underTitleAd} />}

        <div class="post-header__lower">
          <div class="post-header__info">
            {recipe.author && (
              <a href={`/author/${recipe.author.slug}/`} aria-hidden="true" tabindex="-1" class="entry-avatar">
                <img
                  alt={recipe.author.name}
                  src={recipe.author.image_url || 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=120&h=120&fit=crop'}
                  class="avatar avatar-60 photo"
                  height="60"
                  width="60"
                  decoding="async"
                  data-pin-nopin="true"
                />
              </a>
            )}
            <div>
              {recipe.author && (
                <p class="entry-author">By <a href={`/author/${recipe.author.slug}/`}>{recipe.author.name}</a></p>
              )}
              <p class="entry-date">
                <span class="entry-date__published">
                  Published <time datetime={recipe.created_at}>
                    {new Date(recipe.created_at).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                </span>
                            <p class="affiliate-disclosure">
                This post may contain affiliate links.
              </p>
</p>
            </div>
          </div>
          <div class="post-header__meta">
            <div>
              <a
                href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(Astro.url.toString())}&media=${encodeURIComponent(cleanPinterestImage)}&description=${encodeURIComponent(recipe.pin_description || recipe.title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="pinterest-share-button"
              >
                <svg class="pinterest-icon" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.758-1.378l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/>
                </svg>
                Pin Recipe
              </a>
              <a
                href="#recipe-card"
                class="jump-to-recipe-button"
              >
                <svg class="jump-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
                Jump to Recipe
              </a>
            </div>
            <div class="wprm-recipe-meta-container wprm-recipe-custom-container wprm-recipe-details-container wprm-recipe-details-container-separate wprm-block-text-none">
              {recipe.recipe_data.prep_time && (
                <div class="wprm-recipe-block-container wprm-recipe-block-container-separate wprm-block-text-none wprm-recipe-time-container wprm-recipe-prep-time-container">
                  <svg class="wprm-recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="wprm-recipe-details-label wprm-block-text-none wprm-recipe-time-label wprm-recipe-prep-time-label">
                    <span class="sr-only">Prep </span>
                  </span>
                  <span class="wprm-recipe-time wprm-block-text-none">
                    <span class="wprm-recipe-details wprm-recipe-details-minutes wprm-recipe-prep_time wprm-recipe-prep_time-minutes">
                      {recipe.recipe_data.prep_time}<span class="sr-only screen-reader-text wprm-screen-reader-text"> minutes</span>
                    </span>
                    <span class="wprm-recipe-details-unit wprm-recipe-details-minutes wprm-recipe-prep_time-unit wprm-recipe-prep_timeunit-minutes" aria-hidden="true">mins</span>
                  </span>
                </div>
              )}
              {recipe.recipe_data.cook_time && (
                <div class="wprm-recipe-block-container wprm-recipe-block-container-separate wprm-block-text-none wprm-recipe-time-container wprm-recipe-cook-time-container">
                  <svg class="wprm-recipe-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2c1.5 0 2.5 1.5 2.5 3s-1 3-2.5 3-2.5-1.5-2.5-3 1-3 2.5-3zm-3 4c0-1.5-.8-2.5-2-2.5S5 4.5 5 6s.8 2.5 2 2.5S9 7.5 9 6zm8 0c0-1.5-.8-2.5-2-2.5s-2 1-2 2.5.8 2.5 2 2.5 2-1 2-2.5zM3 13c0-3.9 3.1-7 7-7h4c3.9 0 7 3.1 7 7v7c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2v-7z"/>
                  </svg>
                  <span class="wprm-recipe-details-label wprm-block-text-none wprm-recipe-time-label wprm-recipe-cook-time-label">
                    <span class="sr-only">Cook </span>
                  </span>
                  <span class="wprm-recipe-time wprm-block-text-none">
                    <span class="wprm-recipe-details wprm-recipe-details-minutes wprm-recipe-cook_time wprm-recipe-cook_time-minutes">
                      {recipe.recipe_data.cook_time}<span class="sr-only screen-reader-text wprm-screen-reader-text"> minutes</span>
                    </span>
                    <span class="wprm-recipe-details-unit wprm-recipe-details-minutes wprm-recipe-cook_time-unit wprm-recipe-cook_timeunit-minutes" aria-hidden="true">mins</span>
                  </span>
                </div>
              )}
              {recipe.recipe_data.servings && (
                <div class="wprm-recipe-block-container wprm-recipe-block-container-separate wprm-block-text-none wprm-recipe-servings-container">
                  <svg class="wprm-recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <span class="wprm-recipe-details-label wprm-block-text-none wprm-recipe-servings-label">
                    <span class="sr-only">Servings </span>
                  </span>
                  <span class="wprm-recipe-servings-with-unit">
                    <span class="wprm-recipe-servings wprm-recipe-details wprm-recipe-servings-237717 wprm-recipe-servings-adjustable-0 wprm-block-text-none" data-recipe="237717" aria-label="Adjust recipe servings" data-servings={recipe.recipe_data.servings} data-original-servings={recipe.recipe_data.servings}>
                      {recipe.recipe_data.servings}
                    </span>
                    <span class="wprm-recipe-servings-unit wprm-recipe-details-unit wprm-block-text-none">servings</span>
                  </span>
                </div>
              )}</div>
          </div>
        </div>
      </div>
    </div>

  <!-- Main Content Area with Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Main Content -->
      <div class="lg:col-span-2">
        <!-- Featured Image -->
        <div class="mb-8">
          <img
            src={recipe.featured_image}
            srcset={featuredImageSrcset || undefined}
            sizes={featuredImageSizes}
            alt={recipe.title}
            class="w-full h-[80%] object-cover rounded-xl shadow-lg"
            loading="eager"
            fetchpriority="high"
            width="1280"
            height="720"
          />
        </div>

        <!-- Article Content -->
        <div class="article-content">
          <Fragment set:html={articleContentWithAds} />
        </div>

        <!-- Recipe Card -->
        <div id="recipe-card" data-recipe-title={recipe.title}>
          <RecipeDetails
            recipeData={recipe.recipe_data}
            slug={recipe.slug}
            recipeTitle={recipe.title}
            featuredImage={recipe.featured_image}
            pinImage={recipe.pin_image}
            pinDescription={recipe.pin_description}
            className="mb-12"
            adProvider={adProvider}
            adSettings={adSettings}
          />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1 recipe-sidebar">
        <!-- Sidebar Ad -->
        {sidebarAd && <Fragment set:html={sidebarAd} />}

        <!-- Author Box -->
        {recipe.author && (
          <div class="author-box">
            <div class="author-box-content">
              <div class="author-avatar-wrapper">
                <img
                  src={recipe.author.image_url || 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=120&h=120&fit=crop'}
                  alt={recipe.author.name}
                  class="author-avatar"
                />
              </div>
              <h3 class="author-name">{recipe.author.name}</h3>
              <p class="author-title">{recipe.author.title || 'Recipe Creator'}</p>
              {recipe.author.bio && (
                <p class="author-bio">{recipe.author.bio}</p>
              )}
              <a href={pinterestUrl} target="_blank" rel="noopener noreferrer" class="author-pinterest-btn" aria-label="Follow on Pinterest">
                <svg fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.758-1.378l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/>
                </svg>
                Follow on Pinterest
              </a>
              <a href={`/author/${recipe.author.slug}/`} class="author-recipes-btn">
                View All Recipes
              </a>
            </div>
          </div>
        )}

        <!-- Sidebar Middle Ad -->
        {sidebarMiddleAd && <Fragment set:html={sidebarMiddleAd} />}

        <!-- More Recipes Box -->
        {relatedRecipes.length > 0 && (
          <div class="more-recipes-box">
            <h3 class="more-recipes-title">More Recipes</h3>
            <div class="more-recipes-grid">
              {relatedRecipes.map((relatedRecipe) => (
                <article class="recipe-item">
                  <a href={`/${relatedRecipe.slug}/`} class="recipe-link">
                    <div class="recipe-image-wrapper">
                      <img
                        src={relatedRecipe.featured_image}
                        alt={relatedRecipe.title}
                        class="recipe-image"
                      />
                    </div>
                    <div class="recipe-info">
                      <h4 class="recipe-title">
                        {relatedRecipe.title}
                      </h4>
                      {relatedRecipe.category?.name && (
                        <span class="recipe-category">
                          {relatedRecipe.category.name}
                        </span>
                      )}
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        )}

        <!-- Amazon Products - Below More Recipes -->
        {sidebarProducts.length > 0 && (
          <div class="mb-8">
            <AmazonProductGrid products={sidebarProducts} columns={2} />
          </div>
        )}
      </div>

    </div>
  </div>

</Layout>

<style is:global>
/* ================================
   AMAZON PRODUCTS INLINE STYLES
   ================================ */

.amazon-products-inline {
  margin: 2rem 0;
  width: 100%;
}

.afxshop-products-grid {
  display: grid;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}

.afxshop-products-grid[data-col="3"] {
  grid-template-columns: repeat(2, 1fr); /* 2 columns on mobile */
  gap: 1rem;
}

@media (min-width: 640px) {
  .afxshop-products-grid[data-col="3"] {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
}

@media (min-width: 768px) {
  .afxshop-products-grid[data-col="3"] {
    grid-template-columns: repeat(3, 1fr);
  }
}

.afxshop-product-item {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.afxshop-product-item:hover {
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  transform: translateY(-2px);
}

.afxshop-product-header {
  flex: 1;
}

.afxshop-product-header a {
  display: block;
  text-decoration: none;
  color: inherit;
  padding: 1.25rem;
  height: 100%;
}

.afxshop-product-image {
  width: 100%;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
  background: #f9fafb;
  border-radius: 8px;
}

.afxshop-product-image img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.afxshop-product-item:hover .afxshop-product-image img {
  transform: scale(1.05);
}

.afxshop-product-title {
  font-size: 0.95rem;
  line-height: 1.4;
  color: #1f2937;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 4rem;
}

.afxshop-product-footer {
  border-top: 1px solid #f3f4f6;
}

.afxshop-product-offer a {
  display: block;
  text-decoration: none;
}

.afxshop-product-wrap {
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: #ffffff;
  border-top: 1px solid #f3f4f6;
}

.afxshop-product-left {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.afxshop-product-amazon-icon {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.afxshop-product-price {
