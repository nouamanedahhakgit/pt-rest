.pinterest-share-button:hover {
  background: #d50020;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(230, 0, 35, 0.4);
}

.pinterest-icon {
  width: 16px;
  height: 16px;
}

.jump-to-recipe-button {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #ff7849;
  color: white;
  padding: 0.75rem 1.25rem;
  border-radius: 2rem;
  text-decoration: none;
  font-weight: 700;
  font-size: 0.875rem;
  transition: all 0.3s ease;
  width: 200px;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(255, 120, 73, 0.3);
}

.jump-to-recipe-button:hover {
  background: #f9632b;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(255, 120, 73, 0.4);
}

.jump-icon {
  width: 16px;
  height: 16px;
}

/* Minimalist Recipe Meta Styles */
.wprm-recipe-meta-container {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
}

.wprm-recipe-block-container {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-align: left;
}

.wprm-recipe-icon {
  width: 1.25rem;
  height: 1.25rem;
  color: #ff7849;
  flex-shrink: 0;
}

.wprm-recipe-details-label {
  font-weight: 600;
  font-size: 0.875rem;
  color: #6b7280;
  white-space: nowrap;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

.wprm-recipe-time,
.wprm-recipe-servings-with-unit {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
}

.wprm-recipe-details {
  font-size: 1.125rem;
  font-weight: 700;
  color: #111827;
}

.wprm-recipe-details-unit {
  font-size: 0.875rem;
  color: #6b7280;
  font-weight: 500;
}

/* Responsive Header */
@media (max-width: 1024px) {
  .post-header__lower {
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .post-header__meta {
    align-items: flex-start;
    width: 100%;
  }

  .post-header__meta > div:nth-child(1) {
    justify-content: flex-start;
    width: 100%;
  }

  .wprm-recipe-meta-container {
    justify-content: flex-start;
  }
}

@media (max-width: 768px) {
  .post-header .entry-title {
    font-size: 1.5rem;
  }

  .post-header {
    padding: 1.5rem 0;
  }

  .post-header__meta {
    align-items: center;
    justify-content: center;
  }

  .wprm-recipe-meta-container {
    gap: 0.75rem;
    flex-wrap: nowrap;
    justify-content: center;
    overflow-x: auto;
    width: 100%;
  }

  .wprm-recipe-block-container {
    flex-shrink: 0;
  }

  .wprm-recipe-details-label {
    font-size: 0.875rem;
  }

  .wprm-recipe-details {
    font-size: 1.125rem;
  }

  .wprm-recipe-details-unit {
    font-size: 0.875rem;
  }

  /* Keep buttons side by side on mobile */
  .post-header__meta > div:nth-child(1) {
    flex-direction: row;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .pinterest-share-button,
  .jump-to-recipe-button {
    flex: 1;
    min-width: 160px;
  }
}

