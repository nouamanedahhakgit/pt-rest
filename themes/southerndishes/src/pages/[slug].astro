<script>
  // Transform consecutive paragraphs starting with "-" or "–" into bullet lists
  function transformDashedParagraphs() {
    const articleContent = document.querySelector('.article-content');
    if (!articleContent) return;

    const allElements = Array.from(articleContent.children);
    let consecutiveDashParagraphs: HTMLParagraphElement[] = [];
    let groups: HTMLParagraphElement[][] = [];

    // Find groups of consecutive paragraphs starting with "-" or "–"
    allElements.forEach((element, index) => {
      if (element.tagName === 'P') {
        const text = element.textContent?.trim() || '';
        if (text.startsWith('-') || text.startsWith('–')) {
          consecutiveDashParagraphs.push(element as HTMLParagraphElement);
        } else {
          if (consecutiveDashParagraphs.length >= 1) {
            groups.push([...consecutiveDashParagraphs]);
          }
          consecutiveDashParagraphs = [];
        }
      } else {
        if (consecutiveDashParagraphs.length >= 1) {
          groups.push([...consecutiveDashParagraphs]);
        }
        consecutiveDashParagraphs = [];
      }
    });

    // Check last group
    if (consecutiveDashParagraphs.length >= 1) {
      groups.push([...consecutiveDashParagraphs]);
    }

    // Transform each group into a bullet list
    groups.forEach(group => {
      if (group.length > 0) {
        const ul = document.createElement('ul');
        
        // Check if it's em dash to apply special styling
        const isEmDash = group[0].textContent?.trim().startsWith('–');
        if (isEmDash) {
          ul.classList.add('em-dash-list');
        }

        group.forEach(p => {
          const li = document.createElement('li');
          const text = p.textContent?.trim() || '';
          // Remove the leading dash (- or –) and any whitespace after it
          li.textContent = text.replace(/^[-–]\s*/, '');
          ul.appendChild(li);
        });

        // Insert the ul before the first paragraph and remove all paragraphs
        group[0].parentNode?.insertBefore(ul, group[0]);
        group.forEach(p => p.remove());
      }
    });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', transformDashedParagraphs);
  } else {
    transformDashedParagraphs();
  }
</script>