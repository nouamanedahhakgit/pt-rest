/* ================================
   MINIMALIST HEADER DESIGN
   ================================ */

.post-header {
  background: #fefdfb;
  color: #1f2937;
  padding: 2.5rem 0;
  border-bottom: 2px solid #ffd0b5;
}

.post-header .wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.post-header .entry-title {
  font-family: 'Abril Fatface', serif;
  font-size: 2rem;
  font-weight: 400;
  margin-bottom: 1.5rem;
  line-height: 1.2;
  color: #111827;
  letter-spacing: -0.01em;
}

@media (min-width: 768px) {
  .post-header .entry-title {
    font-size: 2.5rem;
  }
}

/* Minimalist Breadcrumb Styles */
.breadcrumb-link {
  display: inline-flex;
  align-items: center;
  color: #6b7280;
  text-decoration: none;
  transition: color 0.2s ease;
}

.breadcrumb-link:hover {
  color: #2ec9ad;
}

.breadcrumb-separator {
  color: #d1d5db;
}

.breadcrumb-current {
  color: #111827;
  font-weight: 600;
}

.post-header__lower {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1rem 0;
}

.post-header__info {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.post-header__info .entry-avatar img {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  border: 2px solid #e5e7eb;
}

.post-header__info .entry-author {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
}

.post-header__info .entry-author a {
  color: #111827;
  text-decoration: none;
}

.post-header__info .entry-author a:hover {
  color: #2ec9ad;
}

.post-header__info .entry-date {
  margin: 0.25rem 0 0 0;
  font-size: 0.875rem;
  color: #6b7280;
}

.post-header__info .affiliate-disclosure {
  margin: 0.5rem 0 0 0;
  font-size: 0.75rem;
  color: #9ca3af;
  font-style: italic;
}

.post-header__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1rem;
}

.post-header__meta > div:nth-child(1) {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.pinterest-share-button {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #e60023;
  color: white;
  padding: 0.75rem 1.25rem;
  border-radius: 2rem;
  text-decoration: none;
  font-weight: 700;
  font-size: 0.875rem;
  transition: all 0.3s ease;
