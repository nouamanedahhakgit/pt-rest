.article-content .wp-block-group.is-style-group-lightbulb ol.is-style-circle-number-list li::before,
.article-content .tip-group.lightbulb-style ol.number-list.circle-style li::before {
  content: counter(item-counter);
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
