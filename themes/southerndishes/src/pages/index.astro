---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import FeaturedCategorySection from '../components/FeaturedCategorySection.astro';
import { DatabaseService } from '../lib/database';
import { type AdProvider, type AdSettings, getAdPlaceholder } from '../lib/ads';

const db = new DatabaseService(Astro.locals.runtime?.env?.DB || {} as any);

let featuredRecipes = [];
let latestRecipes = [];
let categories = [];
let popularRecipes = [];
let dinnerRecipes = [];
let featuredAuthor = null;
let settings: Record<string, string> = {};

try {
  if (Astro.locals.runtime?.env?.DB) {
    [featuredRecipes, latestRecipes, categories, popularRecipes, dinnerRecipes, featuredAuthor, settings] = await Promise.all([
      db.getFeaturedRecipes(6),
      db.getRecipes(12),
      db.getCategories(),
      db.getRecipesByCategory('desserts', 7, 0), // Get 7 dessert recipes (1 for featured image + 6 for grid)
      db.getRecipesByCategory('dinners', 7, 0), // Get 7 dinner recipes (1 for featured image + 6 for grid)
      db.getAuthorById(2), // Get author with ID 2 for the About Me section
      db.getAllSettings()
    ]);
  }
} catch (error) {
  console.error('Error fetching data for homepage:', error);
}

// Ad provider settings
const adProvider = (settings.ad_provider || 'ezoic') as AdProvider;
const adSettings = settings as AdSettings;

// Get ad placeholder for under title
const underTitleAd = getAdPlaceholder('under_title', adProvider, false, adSettings);
---

<Layout
  title="Recipe Website - Delicious Recipes for Every Occasion"
  description="Discover amazing recipes for every meal and occasion. From quick weeknight dinners to special celebration dishes, find your next favorite recipe here."
>
  <!-- Hero Section with Featured Recipe -->
  <section class="relative bg-cream-50 py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {featuredRecipes.length > 0 && (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left: Image -->
          <div class="order-2 lg:order-1">
            <a href={`/${featuredRecipes[0].slug}/`} class="block group">
              <div class="relative overflow-hidden rounded-3xl shadow-2xl">
                <img
                  src={featuredRecipes[0].featured_image}
                  alt={featuredRecipes[0].title}
                  class="w-full h-[400px] lg:h-[500px] object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="eager"
                  fetchpriority="high"
                />
                <div class="absolute top-6 left-6">
                  <span class="bg-coral-500 text-white px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wide shadow-lg">
                    Featured Recipe
                  </span>
                </div>
              </div>
            </a>
          </div>

          <!-- Right: Content -->
          <div class="order-1 lg:order-2 text-center lg:text-left">
            <p class="text-coral-500 font-handwriting text-3xl mb-3">Today's Special</p>
            <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-gray-900 mb-6 leading-tight">
              {featuredRecipes[0].title}
            </h1>
            <p class="text-lg text-gray-600 mb-8 leading-relaxed">
              {JSON.parse(featuredRecipes[0].recipe_json).summary || "Discover this amazing recipe that will become your new favorite!"}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href={`/${featuredRecipes[0].slug}/`}
                class="inline-flex items-center justify-center px-8 py-4 bg-coral-500 hover:bg-coral-600 text-white font-bold rounded-full transition-all hover:shadow-xl text-lg"
              >
                Get Recipe
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
              <a
                href="/recipes"
                class="inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-gray-50 text-gray-700 font-bold rounded-full border-2 border-gray-300 transition-all text-lg"
              >
                Browse All
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Under Title Ad -->
  {underTitleAd && <Fragment set:html={underTitleAd} />}

  <!-- Featured Category Section -->
  {popularRecipes.length > 0 && (
    <FeaturedCategorySection
      badge="YUMMY!"
      title="Desserts Recipes"
      description="Indulge in our collection of irresistible dessert recipes! From decadent chocolate treats to light and fruity delights, discover sweet creations that will satisfy every craving and make every occasion special!"
      featuredImage={popularRecipes[6]?.featured_image || popularRecipes[0]?.featured_image || "https://cheftaling.b-cdn.net/Screenshot%202025-10-30%20at%2016.15.08.png"}
      buttonText="More Desserts"
      buttonLink="/category/desserts"
      recipes={popularRecipes.slice(0, 6)}
    />
  )}

  <!-- Categories Section -->
  {categories.length > 0 && (
    <section class="py-20 bg-gradient-to-b from-white to-cream-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <p class="text-coral-500 font-handwriting text-3xl mb-3">What are you craving?</p>
          <h2 class="font-heading text-4xl md:text-5xl text-gray-900 mb-3">
            Recipe Categories
          </h2>
          <p class="text-gray-600 text-lg max-w-2xl mx-auto">
            Explore our delicious collection of recipes organized by category
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
          {categories.map((category) => (
            <a
              href={`/category/${category.slug}/`}
              class="group flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-1"
            >
              {/* Circular icon container */}
              <div class="relative w-32 h-32 bg-white rounded-full flex items-center justify-center border-3 border-coral-200 group-hover:border-coral-500 transition-all duration-300 shadow-lg group-hover:shadow-2xl mb-3">
                <img
                  src={category.image || 'https://cdn-icons-png.flaticon.com/128/1046/1046857.png'}
                  alt={category.name}
                  class="w-16 h-16 object-contain transition-transform duration-300 group-hover:scale-110"
                  loading="lazy"
                />
              </div>

              {/* Category name */}
              <h3 class="font-bold text-base text-gray-900 group-hover:text-coral-600 transition-colors">
                {category.name}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

    <!-- Featured Category Section -->
  {dinnerRecipes.length > 0 && (
    <FeaturedCategorySection
      badge="YUMMY!"
      title="Dinners Recipes"
      description="Discover delicious dinner recipes that bring joy to your table! From quick weeknight meals to impressive family feasts, explore our collection of savory dishes that make every dinner time memorable!"
      featuredImage={dinnerRecipes[6]?.featured_image || dinnerRecipes[0]?.featured_image || "https://cheftaling.b-cdn.net/Screenshot%202025-10-30%20at%2016.15.08.png"}
      buttonText="More Dinners"
      buttonLink="/category/dinners"
      recipes={dinnerRecipes.slice(0, 6)}
    />
  )}

  <!-- About Me Section -->
  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Image -->
        <div class="order-2 lg:order-1 flex justify-center">
          <div class="relative">
            {featuredAuthor && (
              <img
                src={featuredAuthor.showcase_image || featuredAuthor.image_url || 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=600&h=800&fit=crop&crop=face'}
                alt={featuredAuthor.name}
                class="w-full max-w-md rounded-3xl shadow-2xl"
              />
            )}
            <!-- Decorative element -->
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-coral-100 rounded-full -z-10"></div>
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-cream-300 rounded-full -z-10"></div>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="order-1 lg:order-2 text-center lg:text-left">
          <p class="text-coral-500 font-handwriting text-3xl mb-3">Nice to meet you!</p>
          <h2 class="font-heading text-4xl md:text-5xl text-gray-900 mb-6 leading-tight">
            Hi, I'm {featuredAuthor?.name || 'Elysia'}!
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            {featuredAuthor?.bio || "I'm passionate about creating delicious, easy-to-follow recipes that bring joy to your kitchen. Whether you're a beginner or an experienced cook, you'll find something to love here!"}
          </p>
          <a
            href="/about-us"
            class="inline-flex items-center px-8 py-4 bg-coral-500 hover:bg-coral-600 text-white font-bold rounded-full transition-all hover:shadow-xl"
          >
            Learn More About Me
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter/Search Section -->
  <section class="bg-coral-50 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-coral-600 font-handwriting text-2xl mb-2">Looking for something?</p>
      <h3 class="font-heading text-3xl md:text-4xl text-gray-900 mb-8">
        Search Our Recipes
      </h3>
      <form action="/search" method="GET">
        <div class="relative max-w-2xl mx-auto">
          <input
            type="search"
            name="q"
            placeholder="Search for recipes..."
            class="w-full px-8 py-5 pr-16 rounded-full border-2 border-coral-200 focus:border-coral-400 focus:outline-none text-gray-700 text-lg shadow-lg"
            autocomplete="off"
          />
          <button
            type="submit"
            class="absolute right-2 top-1/2 transform -translate-y-1/2 w-14 h-14 rounded-full bg-coral-500 hover:bg-coral-600 flex items-center justify-center transition-all hover:scale-110 shadow-lg"
            aria-label="Search"
          >
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </section>

  

  <!-- Latest Recipes Section -->
  {latestRecipes.length > 0 && (
    <section class="py-16 bg-cream-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-coral-500 font-handwriting text-2xl mb-2">Fresh from the kitchen</p>
          <h2 class="font-heading text-4xl md:text-5xl text-gray-900 mb-4">
            Latest Recipes
          </h2>
          <p class="text-gray-600 text-lg max-w-2xl mx-auto">
            Check out our newest additions - tried, tested, and absolutely delicious!
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestRecipes.slice(0, 6).map((recipe) => (
            <RecipeCard recipe={recipe} />
          ))}
        </div>
        <div class="text-center mt-12">
          <a
            href="/recipes"
            class="inline-flex items-center px-10 py-4 bg-coral-500 hover:bg-coral-600 text-white font-bold rounded-full transition-all hover:shadow-xl text-lg"
          >
            View All Recipes
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

</Layout>
