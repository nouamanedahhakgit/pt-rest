---
import Layout from '../../layouts/Layout.astro';
import RecipeGrid from '../../components/RecipeGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { DatabaseService } from '../../lib/database';
import { type AdProvider, type AdSettings, getAdPlaceholder } from '../../lib/ads';

export const prerender = false;

export async function getStaticPaths() {
  return [];
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const db = new DatabaseService(Astro.locals.runtime?.env?.DB || {} as any);

// Pagination settings
const RECIPES_PER_PAGE = 12;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const offset = (currentPage - 1) * RECIPES_PER_PAGE;

let author;
let recipes = [];
let recipeCount = 0;
let settings: Record<string, string> = {};

try {
  if (Astro.locals.runtime?.env?.DB) {
    [author, recipes, recipeCount, settings] = await Promise.all([
      db.getAuthorBySlug(slug),
      db.getRecipesByAuthor(slug, RECIPES_PER_PAGE, offset),
      db.getRecipeCountByAuthor(slug),
      db.getAllSettings()
    ]);

    if (!author) {
      return Astro.redirect('/404');
    }
  }
} catch (error) {
  console.error('Error fetching author data:', error);
  return Astro.redirect('/404');
}

if (!author) {
  return Astro.redirect('/404');
}

const totalPages = Math.ceil(recipeCount / RECIPES_PER_PAGE);
const pageTitle = `${author.name} - Recipe Author`;
const pageDescription = author.bio || `View all recipes by ${author.name}`;

// Ad provider settings
const adProvider = (settings.ad_provider || 'ezoic') as AdProvider;
const adSettings = settings as AdSettings;

// Get ad placeholder for under title
const underTitleAd = getAdPlaceholder('under_title', adProvider, false, adSettings);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={author.image_url}
>
  <!-- Author Hero Section -->
  <section class="author-hero-section">
    <div class="author-hero-container">
      <div class="author-hero-content">
        {author.image_url && (
          <div class="author-hero-image-wrapper">
            <div class="author-image-decoration"></div>
            <img
              src={author.image_url}
              alt={author.name}
              class="author-hero-image"
            />
          </div>
        )}
        <div class="author-hero-text">
          <p class="author-hero-label">Recipe Creator</p>
          <h1 class="author-hero-name">{author.name}</h1>
          {author.title && (
            <p class="author-hero-title">{author.title}</p>
          )}
          {author.bio && (
            <p class="author-hero-bio">{author.bio}</p>
          )}
          <div class="author-hero-stats">
            <div class="author-hero-stat">
              <div class="stat-value">{recipeCount}</div>
              <div class="stat-text">{recipeCount === 1 ? 'Recipe' : 'Recipes'}</div>
            </div>
            <div class="author-hero-stat">
              <div class="stat-value">★★★★★</div>
              <div class="stat-text">Top Rated</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Under Title Ad -->
  {underTitleAd && <Fragment set:html={underTitleAd} />}

  <!-- Recipes Section -->
  <div class="author-recipes-section">
    <div class="author-recipes-container">
      <div class="recipes-header">
        <p class="recipes-handwriting">Delicious creations</p>
        <h2 class="recipes-section-title">
          Recipes by {author.name}
        </h2>
      </div>
      <RecipeGrid recipes={recipes} showCategory={true} />

      <!-- Pagination -->
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={`/author/${author.slug}/`}
      />
    </div>
  </div>

    {recipes.length === 0 && (
      <div class="empty-state">
        <div class="empty-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
        <h2 class="empty-title">No Recipes Yet</h2>
        <p class="empty-text">
          {author.name} hasn't published any recipes yet. Check back soon!
        </p>
        <a href="/recipes" class="empty-button">
          Browse All Recipes →
        </a>
      </div>
    )}
  </div>

</Layout>

<style is:global>
/* ================================
   AUTHOR HERO SECTION
   ================================ */
.author-hero-section {
  background: linear-gradient(135deg, #fff5f0 0%, #ffe6d5 100%);
  padding: 5rem 2rem 4rem;
  position: relative;
  overflow: hidden;
}

.author-hero-section::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(255, 120, 73, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.author-hero-container {
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.author-hero-content {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 4rem;
  align-items: center;
}

.author-hero-image-wrapper {
  position: relative;
}

.author-image-decoration {
  position: absolute;
  top: -15px;
  left: -15px;
  right: 15px;
  bottom: 15px;
  background: linear-gradient(135deg, #ff7849 0%, #f9632b 100%);
  border-radius: 50%;
  z-index: 0;
}

.author-hero-image {
  position: relative;
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 50%;
  border: 6px solid white;
  box-shadow: 0 20px 60px rgba(255, 120, 73, 0.3);
  z-index: 1;
}

.author-hero-text {
  padding: 1rem 0;
}

.author-hero-label {
  font-size: 0.875rem;
  font-weight: 700;
  color: #ff7849;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin: 0 0 1rem 0;
}

.author-hero-name {
  font-family: 'Abril Fatface', serif;
  font-size: 3.5rem;
  font-weight: 400;
  color: #111827;
  margin: 0 0 0.75rem 0;
  line-height: 1.1;
}

.author-hero-title {
  font-size: 1.375rem;
  color: #6b7280;
  font-weight: 600;
  margin: 0 0 1.5rem 0;
}

.author-hero-bio {
  font-size: 1.125rem;
  line-height: 1.8;
  color: #374151;
  margin: 0 0 2rem 0;
  max-width: 650px;
}

.author-hero-stats {
  display: flex;
  gap: 3rem;
}

.author-hero-stat {
  text-align: center;
  padding: 1.25rem 2rem;
  background: white;
  border-radius: 1rem;
  border: 2px solid #ffd0b5;
  box-shadow: 0 4px 12px rgba(255, 120, 73, 0.1);
}

.stat-value {
  font-family: 'Abril Fatface', serif;
  font-size: 2rem;
  font-weight: 400;
  color: #ff7849;
  line-height: 1.2;
  margin-bottom: 0.5rem;
}

.stat-text {
  font-size: 0.875rem;
  color: #6b7280;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ================================
   RECIPES SECTION
   ================================ */
.author-recipes-section {
  background: white;
  padding: 5rem 2rem;
}

.author-recipes-container {
  max-width: 1400px;
  margin: 0 auto;
}

.recipes-header {
  text-align: center;
  margin-bottom: 4rem;
}

.recipes-handwriting {
  font-family: 'Caveat', cursive;
  font-size: 2.25rem;
  color: #ff7849;
  margin: 0 0 0.75rem 0;
  font-weight: 600;
}

.recipes-section-title {
  font-family: 'Abril Fatface', serif;
  font-size: 2.75rem;
  font-weight: 400;
  color: #111827;
  margin: 0;
  line-height: 1.2;
}

/* ================================
   EMPTY STATE
   ================================ */
.empty-state {
  text-align: center;
  padding: 5rem 2rem;
  background: linear-gradient(to bottom, #fff5f0 0%, white 100%);
  border-radius: 2rem;
  border: 2px solid #ffd0b5;
  margin-top: 3rem;
}

.empty-icon {
  width: 5rem;
  height: 5rem;
  margin: 0 auto 2rem;
  background: linear-gradient(135deg, #ffe6d5 0%, #ffd0b5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon svg {
  width: 2.5rem;
  height: 2.5rem;
  color: #ff7849;
}

.empty-title {
  font-family: 'Abril Fatface', serif;
  font-size: 2rem;
  font-weight: 400;
  color: #111827;
  margin: 0 0 1rem 0;
}

.empty-text {
  font-size: 1.125rem;
  color: #6b7280;
  margin: 0 0 2rem 0;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

.empty-button {
  display: inline-block;
  padding: 1rem 2.5rem;
  background: linear-gradient(135deg, #ff7849 0%, #f9632b 100%);
  color: white;
  text-decoration: none;
  border-radius: 9999px;
  font-weight: 700;
  font-size: 1rem;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(255, 120, 73, 0.3);
}

.empty-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(255, 120, 73, 0.4);
}

/* ================================
   RESPONSIVE DESIGN
   ================================ */
@media (max-width: 1024px) {
  .author-hero-content {
    grid-template-columns: 250px 1fr;
    gap: 3rem;
  }

  .author-hero-image {
    height: 250px;
  }

  .author-hero-name {
    font-size: 2.75rem;
  }

  .author-hero-stats {
    gap: 2rem;
  }

  .recipes-section-title {
    font-size: 2.25rem;
  }
}

@media (max-width: 768px) {
  .author-hero-section {
    padding: 4rem 1.5rem 3rem;
  }

  .author-hero-content {
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
  }

  .author-hero-image-wrapper {
    max-width: 220px;
    margin: 0 auto;
  }

  .author-hero-image {
    height: 220px;
  }

  .author-image-decoration {
    top: -12px;
    left: -12px;
    right: 12px;
    bottom: 12px;
  }

  .author-hero-name {
    font-size: 2.5rem;
  }

  .author-hero-title {
    font-size: 1.125rem;
  }

  .author-hero-bio {
    font-size: 1rem;
    margin-left: auto;
    margin-right: auto;
  }

  .author-hero-stats {
    justify-content: center;
    gap: 1.5rem;
  }

  .author-hero-stat {
    padding: 1rem 1.5rem;
  }

  .stat-value {
    font-size: 1.75rem;
  }

  .author-recipes-section {
    padding: 4rem 1.5rem;
  }

  .recipes-header {
    margin-bottom: 3rem;
  }

  .recipes-handwriting {
    font-size: 2rem;
  }

  .recipes-section-title {
    font-size: 2rem;
  }

  .empty-state {
    padding: 4rem 1.5rem;
  }
}

@media (max-width: 480px) {
  .author-hero-section {
    padding: 3rem 1rem 2rem;
  }

  .author-hero-image-wrapper {
    max-width: 180px;
  }

  .author-hero-image {
    height: 180px;
  }

  .author-image-decoration {
    top: -10px;
    left: -10px;
    right: 10px;
    bottom: 10px;
  }

  .author-hero-name {
    font-size: 2rem;
  }

  .author-hero-title {
    font-size: 1rem;
  }

  .author-hero-bio {
    font-size: 0.9375rem;
  }

  .author-hero-stats {
    flex-direction: column;
    gap: 1rem;
  }

  .author-hero-stat {
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
  }

  .stat-value {
    font-size: 1.5rem;
  }

  .author-recipes-section {
    padding: 3rem 1rem;
  }

  .recipes-handwriting {
    font-size: 1.75rem;
  }

  .recipes-section-title {
    font-size: 1.75rem;
  }

  .empty-state {
    padding: 3rem 1rem;
  }

  .empty-title {
    font-size: 1.75rem;
  }

  .empty-text {
    font-size: 1rem;
  }

  .empty-button {
    padding: 0.875rem 2rem;
    font-size: 0.9375rem;
  }
}
</style>
