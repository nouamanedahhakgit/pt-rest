{
  "name": "recipe-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:create": "wrangler d1 create recipe-db",
    "db:migrate": "wrangler d1 execute recipe-db --file=./db/migrations/001_initial_schema.sql",
    "db:seed": "wrangler d1 execute recipe-db --file=./db/seeds/001_sample_data.sql",
    "db:migrate:local": "wrangler d1 execute recipe-db --local --file=./db/migrations/001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute recipe-db --local --file=./db/seeds/001_sample_data.sql",
    "db:reset": "wrangler d1 execute recipe-db --file=./db/migrations/001_initial_schema.sql",
    "deploy": "npm run build && wrangler pages deploy",
    "pages:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.11",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.16.0",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "wrangler": "^4.50.0"
  }
}
